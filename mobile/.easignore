# App-root builds use the same source allowlist as repository-root builds.
# Directory negations stay slashless so EAS can descend into allowed folders.
/*
!/app
!/src
!/modules
!/assets
!/package.json
!/package-lock.json
!/app.config.ts
!/tsconfig.json
!/expo-env.d.ts
!/eas.json
!/.easignore
!/.gitignore

# Runtime data, local build outputs, models and signing material never belong
# in a cloud build, even if placed beneath an allowed source directory.
**/node_modules
**/.expo
**/build
**/dist
**/dist-*
**/.gradle
**/data
**/vault
**/models
**/backups
**/backup
**/snapshots
**/.ssh
**/secrets
**/.env
**/.env.*
**/credentials.json
**/conversations*.json
**/devices.json
**/node_identity.json
**/tli_*.json
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*.mobileprovision
**/*.pem
**/*.key
**/*.gguf
**/*.safetensors
**/*.onnx
**/*.bin
**/*.pt
**/*.pth
**/*.db
**/*.sqlite*
**/*.apk
**/*.aab
**/*.ipa
**/*.zip
**/*.tar
**/*.tar.gz
**/*.7z
**/*.log
