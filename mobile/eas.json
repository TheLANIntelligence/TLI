{
  "cli": { "version": ">=18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "node": "22.16.0" },
    "preview": { "distribution": "internal", "node": "22.16.0", "android": { "buildType": "apk", "gradleCommand": ":tli-transport:testReleaseUnitTest :tli-preview:testReleaseUnitTest :app:assembleRelease" } },
    "beta": { "extends": "preview", "developmentClient": false, "autoIncrement": true, "env": { "TLI_APP_VARIANT": "beta" } },
    "simulator": { "extends": "preview", "ios": { "simulator": true } },
    "production": { "autoIncrement": true, "node": "22.16.0" }
  }
}
