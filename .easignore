# EAS archives this Git repository from its root. Only mobile source belongs
# on the mobile build workers; never upload the TLI installation or its data.
/*
!/mobile
/mobile/*
# EAS fs.cp checks directory paths without a trailing slash. Keep these
# negations slashless so the copier can descend into the allowed folders.
!/mobile/app
!/mobile/src
!/mobile/modules
!/mobile/assets
!/mobile/package.json
!/mobile/package-lock.json
!/mobile/app.config.ts
!/mobile/tsconfig.json
!/mobile/expo-env.d.ts
!/mobile/eas.json
!/mobile/.easignore
!/mobile/.gitignore
**/node_modules
**/.expo
**/build
**/dist
**/dist-*
**/.gradle
**/data
**/vault
**/models
**/backups
**/backup
**/snapshots
**/.ssh
**/secrets
**/.env
**/.env.*
**/credentials.json
**/conversations*.json
**/devices.json
**/node_identity.json
**/tli_*.json
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*.mobileprovision
**/*.pem
**/*.key
**/*.gguf
**/*.safetensors
**/*.onnx
**/*.bin
**/*.pt
**/*.pth
**/*.db
**/*.sqlite*
**/*.apk
**/*.aab
**/*.ipa
**/*.zip
**/*.tar
**/*.tar.gz
**/*.7z
**/*.log
